# signature files describe your whole filesystem - never commit them
*.dts

# local agent context - not published
CLAUDE.md

# generated plans and scratch files
plan.sh
tmpuniq.*
*_new.dts

# .NET build output of the C# port
bin/
obj/

# ...but the shipped self-contained binary IS tracked (a global ignore rule
# excludes *.exe, hence the explicit negation)
!csharp/dist/dtsgen.exe
